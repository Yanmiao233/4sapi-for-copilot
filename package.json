{
  "name": "4sapi-for-copilot",
  "displayName": "4SAPI for Copilot Chat",
  "description": "把 4SAPI 聚合 API 的模型（GPT / Claude / Gemini / DeepSeek 等）接入 GitHub Copilot Chat 模型选择器，每个模型的上下文长度、最大输出、思考深度、采样参数均可独立配置。",
  "version": "0.1.0",
  "publisher": "Yanmiao233",
  "license": "MIT",
  "repository": {
  "type": "git",
  "url": "https://github.com/Yanmiao233/4sapi-for-copilot"
  },
  "engines": {
    "vscode": "^1.116.0",
    "node": ">=20"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "4sapi",
    "copilot",
    "github copilot",
    "byok",
    "language model",
    "openai compatible",
    "thinking",
    "reasoning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "4sapi",
        "displayName": "4SAPI"
      }
    ],
    "commands": [
      {
        "command": "4sapi-copilot.setApiKey",
        "title": "4SAPI: 设置 API Key"
      },
      {
        "command": "4sapi-copilot.clearApiKey",
        "title": "4SAPI: 清除 API Key"
      },
      {
        "command": "4sapi-copilot.testConnection",
        "title": "4SAPI: 测试连接"
      },
      {
        "command": "4sapi-copilot.fetchModels",
        "title": "4SAPI: 从服务器拉取模型列表并生成配置"
      },
      {
        "command": "4sapi-copilot.reloadModels",
        "title": "4SAPI: 重新加载模型列表"
      },
      {
        "command": "4sapi-copilot.openSettings",
        "title": "4SAPI: 打开设置"
      },
      {
        "command": "4sapi-copilot.showLogs",
        "title": "4SAPI: 显示日志"
      }
    ],
    "configuration": {
      "title": "4SAPI for Copilot",
      "properties": {
        "4sapi-copilot.baseUrl": {
          "type": "string",
          "default": "https://4sapi.com/v1",
          "enum": [
            "https://4sapi.com/v1",
            "https://4sapi.org/v1",
            "https://4sapi.top/v1",
            "https://4stoken.com/v1"
          ],
          "markdownDescription": "4SAPI 接入地址（`/v1` 结尾，OpenAI 兼容）。海外网络用 `4sapi.com`；国内直连用 `4sapi.org` / `4sapi.top` / `4stoken.com`。"
        },
        "4sapi-copilot.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "4SAPI API Key 的**后备**存放处（明文写入 settings.json，不推荐）。推荐使用命令 `4SAPI: 设置 API Key` 存入系统密钥库（SecretStorage）。两者都配置时优先使用密钥库。"
        },
        "4sapi-copilot.requestHeaders": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "附加到每个请求的自定义 HTTP 头（例如网关鉴权头）。"
        },
        "4sapi-copilot.maxTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "全局 `max_tokens` 上限，`0` 表示不额外限制（按各模型的 `maxOutputTokens` 发送）。"
        },
        "4sapi-copilot.temperature": {
          "type": "number",
          "default": -1,
          "markdownDescription": "全局采样温度，`-1` 表示不发送该参数。模型级 `temperature` 优先。"
        },
        "4sapi-copilot.topP": {
          "type": "number",
          "default": -1,
          "markdownDescription": "全局 `top_p`，`-1` 表示不发送该参数。模型级 `topP` 优先。"
        },
        "4sapi-copilot.enableUsageReporting": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "把 API 返回的 token 用量上报给 Copilot（用于聊天界面的上下文用量显示）。"
        },
        "4sapi-copilot.debugMode": {
          "type": "string",
          "default": "minimal",
          "enum": [
            "minimal",
            "metadata",
            "verbose"
          ],
          "enumDescriptions": [
            "只记录错误",
            "记录请求元信息（模型、思考深度、token 数、耗时）",
            "元信息 + 请求/响应体摘要（注意可能包含代码片段）"
          ],
          "markdownDescription": "日志级别，输出到 `4SAPI` 输出通道。"
        },
        "4sapi-copilot.models": {
          "type": "array",
          "default": [
            {
              "id": "gpt-5.5",
              "name": "GPT-5.5 (4SAPI)",
              "family": "gpt",
              "version": "5.5",
              "detail": "OpenAI 旗舰 · 思考深度可调",
              "maxInputTokens": 200000,
              "maxOutputTokens": 64000,
              "toolCalling": true,
              "imageInput": true,
              "thinking": {
                "style": "openai",
                "supportedEfforts": ["minimal", "low", "medium", "high"],
                "defaultEffort": "medium",
                "canDisable": true
              }
            },
            {
              "id": "claude-sonnet-4-6",
              "name": "Claude Sonnet 4.6 (4SAPI)",
              "family": "claude",
              "version": "4.6",
              "detail": "Anthropic · 思考预算可调",
              "maxInputTokens": 200000,
              "maxOutputTokens": 64000,
              "toolCalling": true,
              "imageInput": true,
              "thinking": {
                "style": "anthropic",
                "supportedEfforts": ["low", "medium", "high", "max"],
                "defaultEffort": "high",
                "canDisable": true,
                "effortBudgets": {
                  "low": 4096,
                  "medium": 8192,
                  "high": 16384,
                  "max": 32768
                }
              }
            },
            {
              "id": "deepseek-v4-pro",
              "name": "DeepSeek V4 Pro (4SAPI)",
              "family": "deepseek",
              "version": "v4",
              "detail": "深度思考 · reasoning_content 流式渲染",
              "maxInputTokens": 655360,
              "maxOutputTokens": 393216,
              "toolCalling": true,
              "imageInput": false,
              "thinking": {
                "style": "deepseek",
                "supportedEfforts": ["low", "high", "max"],
                "defaultEffort": "high",
                "canDisable": true
              }
            },
            {
              "id": "deepseek-v4-flash",
              "name": "DeepSeek V4 Flash (4SAPI)",
              "family": "deepseek",
              "version": "v4",
              "detail": "高性价比 · 思考模式可关",
              "maxInputTokens": 655360,
              "maxOutputTokens": 393216,
              "toolCalling": true,
              "imageInput": false,
              "thinking": {
                "style": "deepseek",
                "supportedEfforts": ["low", "high", "max"],
                "defaultEffort": "high",
                "canDisable": true
              }
            },
            {
              "id": "gemini-2.5-pro",
              "name": "Gemini 2.5 Pro (4SAPI)",
              "family": "gemini",
              "version": "2.5",
              "detail": "百万级上下文",
              "maxInputTokens": 1048576,
              "maxOutputTokens": 65536,
              "toolCalling": true,
              "imageInput": true,
              "thinking": {
                "style": "custom",
                "supportedEfforts": ["low", "medium", "high"],
                "defaultEffort": "medium",
                "canDisable": true,
                "extraBody": {
                  "reasoning_effort": "{{effort}}"
                }
              }
            }
          ],
          "markdownDescription": "暴露到 Copilot Chat 模型选择器的模型清单。**每个模型的参数（上下文长度 `maxInputTokens`、最大输出 `maxOutputTokens`、思考深度 `thinking`、采样参数等）独立配置**。默认条目仅为示例，请以 4SAPI 控制台实际模型名为准（可用命令 `4SAPI: 从服务器拉取模型列表并生成配置` 自动生成）。",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "VS Code 模型选择器中的唯一 ID（也作为未配置 apiModelId 时发给 4SAPI 的模型名）。"
              },
              "apiModelId": {
                "type": "string",
                "description": "实际发送给 4SAPI 的模型名。缺省时与 id 相同。"
              },
              "name": {
                "type": "string",
                "description": "模型选择器中显示的名称。"
              },
              "family": {
                "type": "string",
                "description": "模型族（用于分组），如 gpt / claude / gemini / deepseek。"
              },
              "version": {
                "type": "string",
                "description": "版本号，仅用于展示。"
              },
              "detail": {
                "type": "string",
                "description": "模型选择器中的补充描述。"
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "是否暴露到模型选择器。"
              },
              "contextWindow": {
                "type": "number",
                "description": "模型完整上下文窗口（输入+输出）。设置了它且未设置 maxInputTokens 时，maxInputTokens = contextWindow - maxOutputTokens。"
              },
              "maxInputTokens": {
                "type": "number",
                "description": "上下文长度（最大输入 token 数）。Copilot 按它管理上下文预算与裁剪。"
              },
              "maxOutputTokens": {
                "type": "number",
                "description": "最大输出 token 数。"
              },
              "toolCalling": {
                "type": "boolean",
                "default": true,
                "description": "是否支持工具调用（Agent 模式必需；不支持的模型不会出现在 Agent 会话的模型选择器里）。"
              },
              "imageInput": {
                "type": "boolean",
                "default": false,
                "description": "是否支持图片输入（视觉）。"
              },
              "thinking": {
                "type": "object",
                "description": "思考（推理）能力与深度配置。",
                "properties": {
                  "style": {
                    "type": "string",
                    "enum": [
                      "none",
                      "openai",
                      "deepseek",
                      "anthropic",
                      "custom"
                    ],
                    "default": "none",
                    "enumDescriptions": [
                      "不支持思考",
                      "OpenAI 风格：顶层 reasoning_effort",
                      "DeepSeek 风格：thinking:{type} + reasoning_effort，流式 reasoning_content",
                      "Anthropic 风格：thinking:{type,budget_tokens}",
                      "自定义：仅合并 extraBody，支持 {{effort}} 占位符"
                    ],
                    "description": "思考参数映射协议。"
                  },
                  "supportedEfforts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "支持的思考深度档位，如 [\"minimal\",\"low\",\"medium\",\"high\"] 或 [\"low\",\"high\",\"max\"]。设置后模型选择器出现「思考深度」下拉框。"
                  },
                  "defaultEffort": {
                    "type": "string",
                    "description": "默认思考深度。"
                  },
                  "canDisable": {
                    "type": "boolean",
                    "default": true,
                    "description": "是否允许把思考深度设为 none（完全关闭思考）。"
                  },
                  "budgetTokens": {
                    "type": "number",
                    "description": "anthropic 风格的默认思考预算（budget_tokens）。"
                  },
                  "effortBudgets": {
                    "type": "object",
                    "description": "anthropic 风格：思考深度 → budget_tokens 映射，如 {\"low\":4096,\"high\":16384}。"
                  },
                  "extraBody": {
                    "type": "object",
                    "description": "合并进请求体的额外参数。字符串值中的 {{effort}} 会被替换为当前思考深度。"
                  }
                }
              },
              "temperature": {
                "type": "number",
                "description": "该模型的采样温度，覆盖全局 temperature。-1 表示不发送。"
              },
              "topP": {
                "type": "number",
                "description": "该模型的 top_p，覆盖全局 topP。-1 表示不发送。"
              },
              "maxTokens": {
                "type": "number",
                "description": "该模型请求体中 max_tokens 的值。缺省时取 maxOutputTokens（或全局 maxTokens 上限）。"
              },
              "stop": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "停止序列。"
              },
              "extraBody": {
                "type": "object",
                "description": "合并进该模型请求体的额外参数（最后合并，可覆盖生成的字段）。"
              },
              "requestHeaders": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "该模型专属的附加 HTTP 头，覆盖全局 requestHeaders 中的同名项。"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "npm run clean && tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.116.0",
    "typescript": "^5.6.0"
  }
}
